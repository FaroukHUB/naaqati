APP_NAME=Naaqati
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Africa/Algiers
APP_URL=http://localhost

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# Devise par défaut (phase 1 : Dinar algérien)
NAAQATI_DEVISE=DZD

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Production o2switch / Hostinger : MySQL ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=naaqati
DB_USERNAME=naaqati
DB_PASSWORD=

# --- Dév local rapide : décommenter pour SQLite (et commenter le bloc MySQL) ---
# DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Sur mutualisé (sans worker de queue), on exécute tout en synchrone.
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# === Alertes de commande (à remplir pour activer chaque canal) ===

# Email : passe MAIL_MAILER=smtp et renseigne les infos de ta boite o2switch.
# Exemple o2switch :
#   MAIL_MAILER=smtp
#   MAIL_HOST=mail.ton-domaine.fr   (ou le serveur indiqué dans cPanel)
#   MAIL_PORT=465
#   MAIL_SCHEME=smtps               (SSL ; ou tls/587)
#   MAIL_USERNAME=commandes@mon-agenceweb.fr
#   MAIL_PASSWORD=ton_mot_de_passe_email
#   MAIL_FROM_ADDRESS=commandes@mon-agenceweb.fr
NAAQATI_ADMIN_EMAIL=

# Telegram (bot via @BotFather) : reçois une alerte instantanée sur ton téléphone.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Notifications push (PWA) — clés déjà générées pour toi :
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@mon-agenceweb.fr

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
